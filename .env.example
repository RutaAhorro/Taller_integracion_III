# ==============================================================================
# 1. Base de datos PostgreSQL
# ==============================================================================
# Administrador reservado para inicialización y migraciones, no para runtime.
DB_USER=postgres
DB_PASSWORD=secret_password
DB_NAME=supermercados

# Roles segregados para los servicios (app_identity, app_catalogo, app_scraping, app_rutas).
# Generar valores independientes con `openssl rand -hex 32`. NUNCA subir .env a git.
# Usar formato hexadecimal evita caracteres reservados en las URLs de conexión.
IDENTITY_DB_PASSWORD=
CATALOGO_DB_PASSWORD=
SCRAPING_DB_PASSWORD=
# Opcional: rol app_rutas para el motor de rutas (perfil `rutas` de Compose).
RUTAS_DB_PASSWORD=

# ==============================================================================
# 2. Autenticación y Tokens compartidos
# ==============================================================================
# Clave JWT compartida (Identidad, Catálogo, IA Conversacional, Gateway).
# Generar con `openssl rand -hex 32` (mínimo 32 caracteres). NUNCA subir .env a git.
JWT_SECRET=

# Secreto compartido exclusivo entre Control de Scraping y Catálogo para ingesta.
# Generar con `openssl rand -hex 32` (distinto de JWT_SECRET). NUNCA subir .env a git.
CATALOGO_INTERNAL_TOKEN=

# Token de servicio para que worker y bot operen contra /api/v1/scraper/*.
# Generar con `openssl rand -hex 32` (distinto de los anteriores). NUNCA subir .env a git.
SCRAPING_SERVICE_TOKEN=

# Cliente OAuth de Google (compartido con frontend web como VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# ==============================================================================
# 3. Gateway y Enrutamiento
# ==============================================================================
# IPs/CIDRs confiables del proxy de entrada/Ingress (vacío desconfía de X-Forwarded-*).
GATEWAY_TRUSTED_PROXIES=

# Con perfil `rutas`, el Gateway enruta /api/v1/listas a este origen; vacío no enruta.
RUTAS_URL=

# ==============================================================================
# 4. Redis Broker
# ==============================================================================
# Broker de mensajería y rate limit para tests o ejecución fuera de Compose.
# (Dentro de Docker Compose se fija automáticamente a redis://redis:6379/0).
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# 5. Microservicio IA Conversacional
# ==============================================================================
# Clave de Google AI Studio (modelo Gemini). NUNCA subir .env a git.
GEMINI_API_KEY=

# Clave de Groq (Llama fallback / extracción). NUNCA subir .env a git.
GROQ_API_KEY=

# URL interna HTTP hacia el microservicio de Catálogo.
CATALOGO_INTERNAL_URL=http://catalogo:8080

# Orígenes CORS permitidos para el chatbot (separados por comas, sin comodines).
IA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# 6. Identidad y Correo
# ==============================================================================
# Cookies seguras (false en desarrollo HTTP local, true en producción HTTPS).
IDENTIDAD_COOKIE_SECURE=false

# Orígenes CORS permitidos para Identidad (separados por comas, sin comodines).
IDENTIDAD_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Red dedicada de enlace Gateway -> Identidad.
IDENTIDAD_EDGE_SUBNET=172.30.0.0/24
IDENTIDAD_EDGE_RANGE=172.30.0.128/25
IDENTIDAD_GATEWAY_IP=172.30.0.2

# Correo de Identidad (verificación y recuperación).
# Dejar IDENTIDAD_CORREO_MODO=log para volcar correos en stdout (solo desarrollo local).
IDENTIDAD_CORREO_MODO=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=

# URL frontend para restablecer contraseña (el servicio concatena ?token=).
IDENTIDAD_URL_RESTABLECER=http://localhost:3000/restablecer-contrasena

# ==============================================================================
# 7. Control de Scraping, Worker y Bot de Discord
# ==============================================================================
# Swagger interactivo en /swagger (true en desarrollo local, false en producción).
SCRAPING_SWAGGER_ENABLED=true

# Orígenes CORS permitidos para Control de Scraping.
SCRAPING_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Bot de Discord para control operativo de tareas y notificaciones. NUNCA subir .env a git.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PUSH_CHANNEL_ID=

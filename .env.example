# ==============================================================================
# Plantilla de variables de entorno para desarrollo local (RutaAhorro)
#
# Cómo usarla:
#   1. Ejecuta `bash scripts/preparar_entorno.sh` para crear `.env` con secretos
#      aleatorios seguros (nunca sobrescribe un `.env` existente).
#   2. Completa a mano la sección "B. Completar a mano".
#   3. Nunca subas `.env` a git ni imprimas secretos en logs o issues.
# ==============================================================================

# ==============================================================================
# A. Secretas (obligatorias — autogeneradas por scripts/preparar_entorno.sh)
# ==============================================================================
# Cada secreto debe ser único y tener al menos 32 caracteres sin espacios
# (`openssl rand -hex 24` genera 48 caracteres hexadecimales seguros para URLs).

# Contraseña del superusuario de PostgreSQL (solo inicialización y migraciones).
DB_PASSWORD=

# Contraseñas segregadas por rol de servicio en PostgreSQL.
IDENTITY_DB_PASSWORD=
CATALOGO_DB_PASSWORD=
SCRAPING_DB_PASSWORD=
RUTAS_DB_PASSWORD=

# Clave JWT compartida entre Identidad, Catálogo, Motor de rutas e IA (nunca en Gateway).
JWT_SECRET=

# Tokens internos M2M (todos estrictamente distintos entre sí y de JWT_SECRET).
CATALOGO_INTERNAL_TOKEN=
CATALOGO_CONSULTA_TOKEN=
SCRAPING_SERVICE_TOKEN=

# ==============================================================================
# B. Completar a mano (requeridas para el flujo MVP completo)
# ==============================================================================
# Correos de administradores separados por coma (ej.: persona1@ejemplo.cl,persona2@ejemplo.cl).
ADMIN_EMAILS=

# Cliente OAuth 2.0 de Google (termina en .apps.googleusercontent.com).
# Compose lo inyecta en Identidad y también en Frontend como VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Clave de Google AI Studio para Gemini (proveedor primario del chat IA).
# Sin GEMINI_API_KEY ni GROQ_API_KEY, POST /api/v1/chat responde 503.
GEMINI_API_KEY=

# Clave de Groq (proveedor secundario/respaldo del chat IA — opcional).
GROQ_API_KEY=

# Bot de Discord (opcional; solo si levantas `--profile bot`).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PUSH_CHANNEL_ID=

# ==============================================================================
# C. Obligatorias con valor por defecto funcional para Docker Compose
# ==============================================================================
# Base de datos PostgreSQL.
DB_USER=postgres
DB_NAME=supermercados

# Enrutamiento del Gateway hacia Motor de rutas e IA conversacional.
RUTAS_URL=http://motor-rutas:8001
IA_URL=http://ia-conversacional:8002

# URL interna HTTP de Catálogo consumida por Control, Motor e IA.
CATALOGO_INTERNAL_URL=http://catalogo:8080

# Identidad: cookie Secure en false para HTTP local (en producción HTTPS es true).
IDENTIDAD_COOKIE_SECURE=false

# Red dedicada Gateway <-> Identidad.
IDENTIDAD_EDGE_SUBNET=172.30.0.0/24
IDENTIDAD_EDGE_RANGE=172.30.0.128/25
IDENTIDAD_GATEWAY_IP=172.30.0.2

# Orígenes CORS permitidos por servicio (separados por coma, sin slash final ni comodines).
IDENTIDAD_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CATALOGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SCRAPING_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RUTAS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
IA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Variables públicas del frontend React/Vite (nunca poner secretos aquí).
# En Docker Compose (target production), `frontend` recibe `VITE_GOOGLE_CLIENT_ID`
# automáticamente desde `GOOGLE_CLIENT_ID` al iniciar el contenedor (`entrypoint.sh`),
# sin necesidad de reconstruir; basta reiniciar el contenedor (`docker compose up -d frontend`).
# Define `VITE_GOOGLE_CLIENT_ID` aquí solo si ejecutas Vite fuera de Compose (`npm run dev`).
VITE_API_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=

# ==============================================================================
# D. Opcionales / ajuste avanzado (vacío usa el valor por defecto del servicio)
# ==============================================================================
# Gateway: proxies confiables, timeouts y prefijos por dominio.
GATEWAY_TRUSTED_PROXIES=
GATEWAY_KEEPALIVE_TIMEOUT=30s
GATEWAY_RESPONSE_HEADER_TIMEOUT=20s
GATEWAY_REQUEST_TIMEOUT=
GATEWAY_DIAL_TIMEOUT=
GATEWAY_IDENTIDAD_PREFIXES=
GATEWAY_CATALOGO_PREFIXES=
GATEWAY_RUTAS_PREFIXES=
GATEWAY_SCRAPING_PREFIXES=
GATEWAY_IA_PREFIXES=

# Catálogo: vigencia y límites de consultas internas.
CATALOGO_DISPONIBILIDAD_ANTIGUEDAD_MAXIMA=48h
CATALOGO_MAX_PRODUCTOS_CONSULTA=1000
CATALOGO_MAX_RADIO_KM=50

# Motor de rutas: pool, tope de listas y timeout hacia Catálogo.
RUTAS_DB_POOL_MAX=5
RUTAS_MAX_LISTAS=100
RUTAS_CATALOGO_TIMEOUT=2s

# IA conversacional: modelo y timeouts.
GEMINI_MODEL=
IA_GEMINI_TIMEOUT=6.0
IA_GROQ_TIMEOUT=6.0
IA_CHAT_TIMEOUT_TOTAL=18.0

# Redis para pruebas o ejecución directa fuera de Compose (en Compose es redis://redis:6379/0).
REDIS_URL=redis://localhost:6379/0

# Control de scraping: Swagger activo solo en desarrollo local.
SCRAPING_SWAGGER_ENABLED=true

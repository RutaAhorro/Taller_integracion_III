# Base de Datos (Credenciales Globales para PostgreSQL)
DB_USER=postgres
DB_PASSWORD=secret_password
DB_NAME=supermercados

# API: generar una clave local con `openssl rand -hex 32`; no subirla a Git.
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Gateway: solo IPs/CIDRs reales del Nginx/Ingress de entrada; vacío no confía en X-Forwarded-*.
GATEWAY_TRUSTED_PROXIES=
# Catálogo: orígenes exactos del frontend, separados por comas, sin comodines.
CATALOGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Microservicio de IA Cloud (APIs Externas)
# GROQ se dejo comentado ya que se decidio por gemini 
# pero para futuros planes de optimizacion se dejo la variable de entorno
# GROQ_API_KEY=
GEMINI_API_KEY=

# Microservicio de Mapas / Geoespacial (Ej. Google Maps / Mapbox)
MAPS_API_KEY=tu_maps_key_aqui

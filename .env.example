# PostgreSQL: administrador reservado a inicialización/migraciones, no al runtime.
DB_USER=postgres
DB_PASSWORD=secret_password
DB_NAME=supermercados

# SUP-271: generar tres valores distintos con `openssl rand -hex 32`.
# Compose usa app_identity, app_scraping y app_catalogo. No subir los valores.
# Usar hexadecimal evita tener que codificar caracteres reservados en la URL.
IDENTITY_DB_PASSWORD=
SCRAPING_DB_PASSWORD=
CATALOGO_DB_PASSWORD=
# SUP-240: rol app_rutas del motor de rutas (perfil `rutas` de Compose). Opcional,
# también con `openssl rand -hex 32`; definirlo antes de crear el volumen de la base.
RUTAS_DB_PASSWORD=
RUTAS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Con el perfil `rutas`, el Gateway enruta /api/v1/listas a este origen; vacío no lo enruta.
RUTAS_URL=

# Identidad/Catálogo: misma clave JWT de al menos 32 bytes; generar con
# `openssl rand -hex 32` y no subirla a Git.
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Gateway: solo IPs/CIDRs reales del Nginx/Ingress de entrada; vacío no confía en X-Forwarded-*.
GATEWAY_TRUSTED_PROXIES=
# Catálogo: orígenes exactos del frontend, separados por comas, sin comodines.
CATALOGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Microservicio de IA Cloud (APIs Externas)
# GROQ se dejo comentado ya que se decidio por gemini 
# pero para futuros planes de optimizacion se dejo la variable de entorno
# GROQ_API_KEY=
GEMINI_API_KEY=

# Microservicio de Mapas / Geoespacial (Ej. Google Maps / Mapbox)
MAPS_API_KEY=tu_maps_key_aqui
## SUP-269: secreto compartido sólo entre Control de scraping y Catálogo (>=32 caracteres).
# Generar localmente: openssl rand -hex 32. No usar JWT_SECRET ni subir el valor.
CATALOGO_INTERNAL_TOKEN=


# SUP-272: Identidad independiente. Estos valores corresponden a HTTP local.
# En Kubernetes configurar HTTPS/Secure=true y los proxies reales antes del corte.
IDENTIDAD_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
IDENTIDAD_COOKIE_SECURE=false
# Red dedicada: IP de Gateway fuera del rango dinámico y ambos dentro del subnet.
# Cambiar los tres valores juntos si la red se solapa con otras redes Docker.
IDENTIDAD_EDGE_SUBNET=172.30.0.0/24
IDENTIDAD_EDGE_RANGE=172.30.0.128/25
IDENTIDAD_GATEWAY_IP=172.30.0.2

# Token de servicio de Control de scraping: worker y bot lo envían como
# `Authorization: Bearer` en /api/v1/scraper/*. Generar con `openssl rand -hex 32`,
# mínimo 32 caracteres y distinto de CATALOGO_INTERNAL_TOKEN y JWT_SECRET.
SCRAPING_SERVICE_TOKEN=
# Swagger de Control (/swagger). Compose lo activa por defecto en local;
# Kubernetes lo deja en false para no publicar el contrato.
SCRAPING_SWAGGER_ENABLED=true

# SUP-273: Control independiente; sin JWT_SECRET en su contenedor.
SCRAPING_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

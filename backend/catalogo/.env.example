# PostgreSQL existente con el rol app_catalogo; no ejecutar migraciones ni AutoMigrate en este servicio.
DB_URL=postgres://app_catalogo:password@localhost:5432/supermercados?sslmode=disable
# Debe coincidir con JWT_SECRET de Identidad (al menos 32 bytes). No existe valor de respaldo.
JWT_SECRET=
# Vacío deshabilita la ingesta interna (modo lector).
# Al menos 32 caracteres, distinto de JWT_SECRET; debe coincidir con el que usa
# Control de scraping.
CATALOGO_INTERNAL_TOKEN=
# Token de solo lectura para la consulta de disponibilidad (Listas e IA).
# Vacío deshabilita la ruta de consulta. Al menos 32 caracteres y estrictamente
# distinto de JWT_SECRET y CATALOGO_INTERNAL_TOKEN.
CATALOGO_CONSULTA_TOKEN=

# Orígenes exactos separados por comas. Vacío rechaza peticiones con Origin.
# CATALOGO_CORS_ALLOWED_ORIGINS tiene prioridad; CORS_ALLOWED_ORIGINS es respaldo.
CATALOGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=
PORT=8080

# Pool de conexiones PostgreSQL.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# IDs aceptados por lote en la consulta interna de disponibilidad.
CATALOGO_MAX_PRODUCTOS_CONSULTA=1000
# Antigüedad máxima de la captura más reciente para considerarla vigente.
CATALOGO_DISPONIBILIDAD_ANTIGUEDAD_MAXIMA=48h

# Plazos HTTP y de ciclo de vida (duraciones de Go, positivas).
CATALOGO_READ_HEADER_TIMEOUT=5s
CATALOGO_READ_TIMEOUT=30s
CATALOGO_WRITE_TIMEOUT=30s
CATALOGO_IDLE_TIMEOUT=60s
CATALOGO_SHUTDOWN_TIMEOUT=15s
CATALOGO_STARTUP_TIMEOUT=5s
CATALOGO_READINESS_TIMEOUT=2s

# Límites de listados, búsqueda e ingesta (enteros positivos).
CATALOGO_DEFAULT_PAGE_SIZE=20
CATALOGO_MAX_PAGE_SIZE=100
CATALOGO_MAX_SEARCH_LENGTH=100
CATALOGO_MAX_BATCH_PRODUCTOS=1000
CATALOGO_MAX_BODY_BYTES=8388608

# Sólo pruebas: base PostgreSQL desechable con rol app_catalogo. Vacía omite la prueba.
CATALOGO_TEST_DB_URL=

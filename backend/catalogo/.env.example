# PostgreSQL existente; no ejecutar migraciones ni AutoMigrate en este servicio.
DB_URL=postgres://usuario:password@localhost:5432/supermercados?sslmode=disable
# Debe coincidir con JWT_SECRET de la API/Identidad. No existe valor de fallback.
JWT_SECRET=
# Origen HTTP(S) de Identidad para revalidar estado/rol en /admin/productos.
# Vacío mantiene el catálogo público, pero la administración responde 503.
IDENTIDAD_URL=http://localhost:8080
# Orígenes exactos separados por comas. Vacío rechaza peticiones con Origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8083
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
# Vacío deshabilita la API de ingesta (modo lector). Debe coincidir con la API.
CATALOGO_INTERNAL_TOKEN=

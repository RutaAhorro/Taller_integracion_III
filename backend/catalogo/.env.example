# PostgreSQL existente con el rol app_catalogo; no ejecutar migraciones ni AutoMigrate en este servicio.
DB_URL=postgres://app_catalogo:password@localhost:5432/supermercados?sslmode=disable
# Debe coincidir con JWT_SECRET de Identidad. No existe valor de respaldo.
JWT_SECRET=
# Vacío deshabilita la API de ingesta (modo lector). Al menos 32 caracteres,
# distinto de JWT_SECRET; debe coincidir con el que usa Control de scraping.
CATALOGO_INTERNAL_TOKEN=

# Orígenes exactos separados por comas. Vacío rechaza peticiones con Origin.
# Se lee CATALOGO_CORS_ALLOWED_ORIGINS y, si está vacía, CORS_ALLOWED_ORIGINS.
CATALOGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8083

# Pool de conexiones PostgreSQL.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Plazos (duraciones de Go positivas). Vacío usa el valor indicado.
CATALOGO_READ_HEADER_TIMEOUT=5s
CATALOGO_READ_TIMEOUT=30s
CATALOGO_WRITE_TIMEOUT=30s
CATALOGO_IDLE_TIMEOUT=60s
CATALOGO_SHUTDOWN_TIMEOUT=15s
# Verificación de tablas y permisos al arrancar.
CATALOGO_STARTUP_TIMEOUT=5s
# Ping a PostgreSQL de /_catalogo/ready.
CATALOGO_READINESS_TIMEOUT=2s

# Límites (enteros positivos).
# Tamaño de página sin limit y tope de limit en listados.
CATALOGO_DEFAULT_PAGE_SIZE=20
CATALOGO_MAX_PAGE_SIZE=100
# Bytes conservados del texto de búsqueda (una letra con tilde ocupa 2).
CATALOGO_MAX_SEARCH_LENGTH=100
# Productos aceptados por lote de ingesta.
CATALOGO_MAX_BATCH_PRODUCTOS=1000

# Variables del worker de scraping en Go.
#
# Los valores mostrados son los defaults de config.Default(); dejar una
# variable vacía equivale a no definirla. En Docker Compose varias se fijan
# directamente en docker-compose.yml.

# ------------------------------------------------------------------------------
# Cola y Control de Scraping
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
SCRAPER_API_URL=http://localhost:8082/api/v1/scraper/productos
# Obligatorio en ejecución: Control de Scraping rechaza al worker sin token.
SCRAPING_SERVICE_TOKEN=
SCRAPER_QUEUE_NAME=scraper:jobs:stream
SCRAPER_GROUP=scraper-workers

# ------------------------------------------------------------------------------
# Spool y capacidad
# ------------------------------------------------------------------------------
SCRAPER_STATE_DIR=/var/lib/scraper
# Reserva mínima de espacio libre; Validate() exige al menos 1 MiB.
SCRAPER_STATE_MIN_FREE_BYTES=67108864
SCRAPER_FAILED_RETENTION_SECONDS=86400

# ------------------------------------------------------------------------------
# Lease y entrega
# ------------------------------------------------------------------------------
# Validate() exige al menos 10 s.
SCRAPER_LEASE_MS=60000
SCRAPER_API_TIMEOUT=30
# Productos por lote (1..1000).
SCRAPER_API_BATCH_SIZE=100

# ------------------------------------------------------------------------------
# Categorías y catálogo de sitios
# ------------------------------------------------------------------------------
# Directorio con <cadena>_categories.txt dentro de la imagen.
SCRAPER_CATEGORY_DIR=/app/research
# Override opcional del catálogo embebido (internal/catalog/spiders.json).
SCRAPER_SPIDERS_FILE=
# Categorías adicionales separadas por coma (el catálogo usa CategoryEnv).
JUMBO_CATEGORY_URLS=
SANTA_ISABEL_CATEGORY_URLS=
CUGAT_CATEGORY_URLS=
ACUENTA_CATEGORY_URLS=
LIDER_CATEGORY_URLS=

# ------------------------------------------------------------------------------
# Crawler HTTP
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
SCRAPER_USER_AGENT=TallerIntegracionIII/1.0 (contacto del proyecto)
SCRAPER_DOWNLOAD_DELAY_MS=2000
SCRAPER_DOWNLOAD_TIMEOUT=30
SCRAPER_DOWNLOAD_MAXSIZE=5242880
SCRAPER_RETRY_TIMES=3
SCRAPER_MAX_PAGES=100
SCRAPER_ROBOTS_CACHE_TTL_SECONDS=3600
SCRAPER_ROBOTS_FAILURE_TTL_SECONDS=600
SCRAPER_ROBOTS_MAX_BYTES=524288
SCRAPER_BACKOFF_MIN_MS=10
SCRAPER_BACKOFF_MAX_SECONDS=120

# ------------------------------------------------------------------------------
# Bucle del worker y recuperación
# ------------------------------------------------------------------------------
SCRAPER_REDIS_TIMEOUT_SECONDS=5
SCRAPER_REDIS_PING_TIMEOUT_SECONDS=5
SCRAPER_QUEUE_BLOCK_MS=1000
SCRAPER_JOB_CLOSED_TTL_SECONDS=86400
SCRAPER_POLL_INTERVAL_MS=200
SCRAPER_RETRY_INTERVAL_SECONDS=5
SCRAPER_COLLECT_INTERVAL_SECONDS=10
SCRAPER_COLLECT_LIMIT=20
SCRAPER_COLLECT_TIMEOUT_SECONDS=5
SCRAPER_GC_TIMEOUT_SECONDS=2
SCRAPER_CRAWL_ATTEMPTS=3

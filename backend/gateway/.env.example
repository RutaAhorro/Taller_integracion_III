# Dirección y puerto de escucha del Gateway
GATEWAY_LISTEN_ADDR=:8082

# Orígenes de los microservicios de dominio (sin credenciales, rutas ni query)
SCRAPING_URL=http://127.0.0.1:8080
CATALOGO_URL=http://127.0.0.1:8083
IDENTIDAD_URL=http://127.0.0.1:8084
RUTAS_URL=http://127.0.0.1:8001
IA_URL=http://127.0.0.1:8002
# BACKEND_URL sólo se usa en modo legado o rollback cuando SCRAPING_URL no está definido
BACKEND_URL=

# Timeouts de red y ciclo de vida (duraciones de Go positivas, ej. 5s, 30s)
GATEWAY_REQUEST_TIMEOUT=30s
GATEWAY_DIAL_TIMEOUT=5s
GATEWAY_RESPONSE_HEADER_TIMEOUT=10s
GATEWAY_READ_HEADER_TIMEOUT=5s
GATEWAY_IDLE_TIMEOUT=60s
GATEWAY_SHUTDOWN_TIMEOUT=10s
GATEWAY_READINESS_TIMEOUT=2s
GATEWAY_KEEPALIVE_TIMEOUT=30s

# Proxies de entrada confiables (IPs o CIDRs separados por comas)
GATEWAY_TRUSTED_PROXIES=

# Prefijos de rutas configurables (opcionales; defaults estándar del sistema)
GATEWAY_CATALOGO_PREFIXES=/api/v1/productos,/api/v1/admin/productos
GATEWAY_IDENTIDAD_PREFIXES=/api/v1/auth,/api/v1/admin/usuarios
GATEWAY_RUTAS_PREFIXES=/api/v1/listas
GATEWAY_SCRAPING_PREFIXES=/api/v1/scraper,/swagger
GATEWAY_IA_PREFIXES=/api/v1/chat

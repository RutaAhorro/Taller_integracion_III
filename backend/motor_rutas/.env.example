# Motor de rutas (SUP-348). En Compose estas variables vienen de docker-compose.yml.
PORT=8001
# DSN exclusivo de app_rutas; nunca el operador ni otro rol.
RUTAS_DB_URL=postgres://app_rutas:CAMBIAR@localhost:5432/bd_supermercados?sslmode=disable
# La misma clave de Identidad y Catálogo, al menos 32 bytes.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
RUTAS_DB_POOL_MAX=5
# Tope defensivo de listas por usuario (1 a 1000).
RUTAS_MAX_LISTAS=100

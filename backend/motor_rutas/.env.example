# Motor de rutas (SUP-348). En Compose estas variables vienen de docker-compose.yml.
PORT=8001
# DSN exclusivo de app_rutas; nunca el operador ni otro rol.
RUTAS_DB_URL=postgres://app_rutas:CAMBIAR@localhost:5432/bd_supermercados?sslmode=disable
# La misma clave de Identidad y Catálogo, al menos 32 bytes.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
RUTAS_DB_POOL_MAX=5
# Tope defensivo de listas por usuario (1 a 1000).
RUTAS_MAX_LISTAS=100
# Consulta de disponibilidad de Catálogo (SUP-241). El token es el mismo
# CATALOGO_CONSULTA_TOKEN que define Catálogo; al menos 32 bytes.
CATALOGO_INTERNAL_URL=http://localhost:8083
CATALOGO_CONSULTA_TOKEN=
RUTAS_CATALOGO_TIMEOUT=5s
# Parámetros del optimizador MVP (POST /api/v1/rutas/optimizar).
RUTAS_RADIO_KM=10
RUTAS_MAX_SUCURSALES=10
RUTAS_MAX_PARADAS=3
RUTAS_MAX_ARTICULOS=30
RUTAS_FACTOR_DISTANCIA=1.3
RUTAS_UMBRAL_AHORRO=500

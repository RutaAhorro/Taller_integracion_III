# Plantilla del proceso Identidad; no se carga automáticamente desde Go.
# Inyectar estas variables desde el entorno o el gestor de secretos.
# No reemplaza ni modifica el .env local de la raíz del proyecto.

# Conexiones y secretos compartidos: mismos nombres de SUP-345.
# IDENTITY_DB_URL: DSN PostgreSQL con app_identity, base y contraseña explícitos.
IDENTITY_DB_URL=
# JWT_SECRET: obligatorio, >=32 bytes sin espacios externos; sin respaldo.
JWT_SECRET=
REDIS_URL=redis://localhost:6379/0
PORT=8080
# Vacío deshabilita Google. Usar el mismo ID público que el frontend.
GOOGLE_CLIENT_ID=
# Correos de administradores separados por coma (opcional). Solo aplica tras
# validar email_verified=true en login con Google; nunca en registro local.
ADMIN_EMAILS=
# En producción usar true; false solo para HTTP local.
IDENTIDAD_COOKIE_SECURE=true
# Solo "true"/"false". false (por defecto) bloquea registro y login local con 403.
AUTH_LOCAL_HABILITADO=false
# IP/CIDR real de Gateway: obligatorio; nunca 0.0.0.0/0 ni ::/0.
IDENTIDAD_TRUSTED_PROXIES=
# Orígenes HTTP(S) exactos separados por coma, sin path ni comodines.
CORS_ALLOWED_ORIGINS=

# Plazos, límites y tamaño del pool son constantes del servicio
# (internal/config/config.go), no variables de entorno.

# JWT y cookie mantienen el contrato de 24 horas. Sin nueva variable de TTL.

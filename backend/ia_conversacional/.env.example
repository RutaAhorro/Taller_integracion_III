# ==============================================================================
# Variables de entorno compartidas (SUP-345)
# ==============================================================================

# Secreto para validar tokens JWT emitidos por Identidad (algoritmo HS256).
# Obligatoria (>= 32 bytes / caracteres, sin fallback). Generar con: openssl rand -hex 32
JWT_SECRET=

# Orígenes CORS exactos permitidos separados por comas, sin barra final ni comodines '*'.
# Fallback en lectura a CORS_ALLOWED_ORIGINS.
IA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Origen HTTP interno limpio hacia el microservicio de Catálogo (sin path, query ni fragmento).
# Compose: http://catalogo:8080 | Local: http://localhost:8080 o http://localhost:8083
CATALOGO_INTERNAL_URL=http://catalogo:8080

# Clave de API de Google AI Studio para el proveedor LLM primario (Gemini).
GEMINI_API_KEY=

# Clave de API de Groq Cloud para el proveedor LLM secundario/resiliencia (Groq).
GROQ_API_KEY=

# ==============================================================================
# Integración con Catálogo y Caché Local
# ==============================================================================

# Tiempo de espera en segundos para peticiones HTTP internas a Catálogo.
CATALOGO_TIMEOUT=5.0

# Tiempo de vida en segundos (TTL) de la caché en memoria de productos de catálogo.
IA_CATALOGO_CACHE_TTL=60.0

# Cantidad de productos solicitados por página al endpoint interno de Catálogo.
IA_CATALOGO_PAGE_LIMIT=100

# Límite máximo de páginas a solicitar a Catálogo para prevenir agotamiento de memoria.
IA_CATALOGO_MAX_PAGINAS=10

# ==============================================================================
# Proveedor Groq (Proveedor Secundario / Fallback)
# ==============================================================================

# Endpoint de inferencia compatible con OpenAI de Groq.
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Modelo ligero y rápido utilizado para la extracción estructurada de filtros.
GROQ_MODEL_EXTRACCION=llama-3.1-8b-instant

# Modelo con mayor capacidad de redacción utilizado para la explicación final.
GROQ_MODEL_EXPLICACION=llama-3.3-70b-versatile

# Tiempo de espera máximo en segundos para solicitudes HTTP a Groq.
IA_GROQ_TIMEOUT=15.0

# Límite de tokens de respuesta para la etapa de extracción de filtros en Groq.
IA_GROQ_MAX_TOKENS_EXTRACCION=512

# Límite de tokens de respuesta para la etapa de explicación en Groq.
IA_GROQ_MAX_TOKENS_EXPLICACION=200

# Penalización de frecuencia en Groq para evitar repeticiones en las respuestas.
IA_GROQ_FREQUENCY_PENALTY=0.4

# ==============================================================================
# Proveedor Gemini (Proveedor Primario)
# ==============================================================================

# Modelo de Google AI Studio utilizado para extracción y explicación.
GEMINI_MODEL=gemini-3.1-flash-lite

# URL base de la API REST de Google Generative Language.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Tiempo de espera máximo en segundos para solicitudes HTTP a Gemini.
IA_GEMINI_TIMEOUT=15.0

# Nivel de pensamiento/razonamiento en Gemini ('low' minimiza latencia y uso de cuota).
IA_GEMINI_THINKING_LEVEL=low

# Límite de tokens de respuesta para la extracción de filtros en Gemini.
IA_GEMINI_MAX_TOKENS_EXTRACCION=1200

# Límite de tokens de respuesta para la explicación en Gemini.
IA_GEMINI_MAX_TOKENS_EXPLICACION=2048

# ==============================================================================
# Resiliencia, Reintentos y Fallback
# ==============================================================================

# Cantidad máxima de reintentos para el proveedor primario (Gemini) ante 429/503/timeout.
IA_FALLBACK_RETRIES_PRIMARIO=4

# Cantidad máxima de reintentos para el proveedor secundario (Groq).
IA_FALLBACK_RETRIES_SECUNDARIO=1

# Tiempo base en segundos para el cálculo de backoff exponencial.
IA_FALLBACK_BACKOFF_BASE=1.5

# Jitter aleatorio máximo en segundos sumado al tiempo de espera de reintento.
IA_FALLBACK_JITTER_MAX=0.5

# ==============================================================================
# Límites de Mensajes y Contexto
# ==============================================================================

# Longitud máxima en caracteres permitida para el mensaje del usuario en ChatRequest.
IA_CHAT_MAX_MENSAJE_LEN=1000

# Cantidad máxima de productos filtrados inyectados en el prompt de explicación.
IA_EXPLICACION_MAX_PRODUCTOS=8

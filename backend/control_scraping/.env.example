# Variables compartidas: conservar los nombres acordados en GUIA_CONFIGURACION.
SCRAPING_DB_URL=postgres://app_scraping:<password>@localhost:5432/<database>?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CATALOGO_INTERNAL_URL=http://127.0.0.1:8083
CATALOGO_INTERNAL_TOKEN=
SCRAPING_SERVICE_TOKEN=

# Configuración local del servicio.
CATALOGO_INGEST_TIMEOUT=10s
SCRAPING_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SCRAPING_SWAGGER_ENABLED=true
PORT=8080

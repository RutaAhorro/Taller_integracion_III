# Credenciales de Discord. No usar credenciales reales en este archivo.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PUSH_CHANNEL_ID=

# Acceso de servicio a Control; debe ser el mismo secreto inyectado a Control.
SCRAPING_SERVICE_TOKEN=
SCRAPER_API_BASE_URL=http://api:8080/api/v1/scraper/trabajos

# Valores operativos opcionales y sus valores predeterminados.
PORT=8080
SCRAPER_HTTP_TIMEOUT=15s
BOT_HTTP_READ_HEADER_TIMEOUT=5s
SCRAPER_POLL_INTERVAL=5s
SCRAPER_MONITOR_MAX_FAILURES=12
DISCORD_REVIEW_DEBOUNCE=2500ms
